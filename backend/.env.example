# ═══════════════════════════════════════════════════════════════
#  ClimateSphere AI – Backend Environment Variables
#  Copy this file to .env (inside the backend/ folder) and fill
#  in your real keys. NEVER commit your real .env file.
# ═══════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────
# OpenWeatherMap API key — free tier supports current weather + 5-day forecast
# Get one at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API key — required for AI conversational intelligence & scientific research
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — primary provider for ultra-fast conversational responses & weather synthesis
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ───────────────────────────────────────────────────
# AI provider routing mode: 'auto' (default: Groq for chat, Gemini for research) | 'groq' | 'gemini'
AI_PROVIDER=auto

# Groq model to use (default: openai/gpt-oss-20b with fallback to llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-20b

# Gemini model to use (default: gemini-3.8-flash with fallback to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache TTL in seconds (how long weather responses are cached before re-fetching)
CACHE_TTL_SECONDS=300

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
